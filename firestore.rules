rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function userData() {
      return get(userPath(request.auth.uid)).data;
    }

    function hasPermission(permission) {
      return hasUserProfile()
        && userData().permissions is list
        && userData().permissions.hasAny([permission]);
    }

    function isAdmin() {
      return hasPermission('admin');
    }

    function isSupporter() {
      return hasPermission('supporter');
    }

    function isTeamMember(team) {
      return hasUserProfile()
        && !isSupporter()
        && userData().team is list
        && userData().team.hasAny([team]);
    }

    function isDelegate(team) {
      return hasPermission('afgevaardigde:*')
        || hasPermission('afgevaardigde:' + team);
    }

    function canManageMatch(matchInfo) {
      return !isSupporter() && (
        isAdmin()
        || hasPermission('score_invullen')
        || isDelegate(matchInfo.team)
      );
    }

    function canSeeMatchAttendance(matchInfo) {
      return !isSupporter() && (
        isAdmin()
        || hasPermission('score_invullen')
        || isTeamMember(matchInfo.team)
        || isDelegate(matchInfo.team)
        || (hasUserProfile()
          && matchInfo.aangeduidePersonen is list
          && matchInfo.aangeduidePersonen.hasAny([request.auth.uid]))
      );
    }

    function validVoteEntry(vote, matchInfo, voterUid) {
      return vote is map
        && vote.keys().hasAll(['uid', 'name', 'rank'])
        && vote.keys().hasOnly(['uid', 'name', 'rank'])
        && vote.uid is string
        && vote.uid != voterUid
        && matchInfo.motmCandidateUids is list
        && matchInfo.motmCandidateUids.hasAny([vote.uid])
        && vote.rank is int
        && vote.rank in [1, 2, 3]
        && vote.name is string
        && vote.name.size() > 0
        && vote.name.size() <= 100
        && get(/databases/$(database)/documents/public_profiles/$(vote.uid)).data.name == vote.name;
    }

    function validVoteBallot(votes, matchInfo, voterUid) {
      return votes is list
        && votes.size() >= 1
        && votes.size() <= 3
        && validVoteEntry(votes[0], matchInfo, voterUid)
        && (votes.size() < 2 || (
          validVoteEntry(votes[1], matchInfo, voterUid)
          && votes[0].uid != votes[1].uid
          && votes[0].rank != votes[1].rank
        ))
        && (votes.size() < 3 || (
          validVoteEntry(votes[2], matchInfo, voterUid)
          && votes[0].uid != votes[2].uid
          && votes[1].uid != votes[2].uid
          && votes[0].rank != votes[2].rank
          && votes[1].rank != votes[2].rank
        ));
    }

    function canVoteForMatch(matchInfo) {
      return hasUserProfile()
        && (!('motmResults' in matchInfo) || matchInfo.motmResults == null)
        && matchInfo.status == 'finished'
        && (
          (isSupporter() && userData().team is list && userData().team.hasAny([matchInfo.team]))
          || (!isSupporter() && (
            (('motmEligibleUids' in matchInfo)
              && matchInfo.motmEligibleUids is list
              && matchInfo.motmEligibleUids.hasAny([request.auth.uid]))
            || isDelegate(matchInfo.team)
          ))
        );
    }

    function validOwnAccountRequest() {
      return request.resource.data.keys().hasAll([
          'naam', 'email', 'encryptedPassword', 'categorie', 'ploegen',
          'accountType', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'naam', 'email', 'encryptedPassword', 'categorie', 'ploegen',
          'accountType', 'telefoon', 'status', 'createdAt'
        ])
        && request.resource.data.naam is string
        && request.resource.data.naam.size() > 0
        && request.resource.data.naam.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && request.resource.data.encryptedPassword is string
        && request.resource.data.encryptedPassword.size() <= 4096
        && request.resource.data.categorie is string
        && request.resource.data.ploegen is list
        && request.resource.data.ploegen.size() >= 1
        && request.resource.data.ploegen.size() <= 3
        && request.resource.data.accountType in ['speler', 'supporter']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('telefoon' in request.resource.data)
          || (request.resource.data.telefoon is string && request.resource.data.telefoon.size() <= 40));
    }

    function validOwnAvailability(uid) {
      return uid == request.auth.uid
        && request.resource.data.keys().hasAll(['available', 'displayName', 'timestamp'])
        && request.resource.data.keys().hasOnly([
          'available', 'displayName', 'timestamp', 'isExternalPlayer',
          'fromTeam', 'addedBy'
        ])
        && request.resource.data.available is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.timestamp is string;
    }

    function validEventRegistrationCreate(eventId, uid) {
      let event = get(/databases/$(database)/documents/evenementen/$(eventId)).data;
      return signedIn()
        && !isSupporter()
        && uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'naam', 'email', 'extraAntwoorden', 'ingeschrevenOp'])
        && request.resource.data.keys().hasOnly(['uid', 'naam', 'email', 'extraAntwoorden', 'ingeschrevenOp'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.naam is string
        && request.resource.data.naam.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.extraAntwoorden is list
        && request.resource.data.extraAntwoorden.size() <= 30
        && event.inschrijvingenAan == true
        && (!('maxDeelnemers' in event)
          || !(event.maxDeelnemers is int)
          || event.maxDeelnemers <= 0
          || !('inschrijvingenCount' in event)
          || event.inschrijvingenCount < event.maxDeelnemers);
    }

    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'pushSettings'])
          && (!('fcmTokens' in request.resource.data)
            || (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 20))
          && (!('pushSettings' in request.resource.data)
            || request.resource.data.pushSettings is map))
        || (hasPermission('score_invullen')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
          && request.resource.data.stats is map
          && request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly([
            'goals', 'assists', 'yellowCard', 'redCard', 'matches', 'minutes'
          ]));
    }

    match /public_profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /account_requests/{requestId} {
      allow create: if validOwnAccountRequest();
      allow read, update, delete: if isAdmin();
    }

    match /contactberichten/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'bericht', 'datum', 'gelezen', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'bericht', 'datum', 'gelezen', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.bericht is string
        && request.resource.data.bericht.size() > 0
        && request.resource.data.bericht.size() <= 5000
        && request.resource.data.datum is timestamp
        && request.resource.data.gelezen == false
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (canManageMatch(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'scoreThuis', 'scoreUit', 'lineup', 'lineupDraft',
            'lineupDraftConfirmed', 'phase', 'pausedAt', 'extraTimeStarted',
            'currentMinute', 'timerStartedAt', 'timerPausedAt', 'timerOffset',
            'halfDuration', 'extraTimePhase', 'wedstrijdEvents'
          ]));

      match /availability/{availabilityUid} {
        allow get: if canSeeMatchAttendance(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        ) || (signedIn() && !isSupporter() && availabilityUid == request.auth.uid);
        allow list: if canSeeMatchAttendance(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        );
        allow create, update: if canManageMatch(
            get(/databases/$(database)/documents/matches/$(matchId)).data
          ) || (signedIn()
            && !isSupporter()
            && isTeamMember(get(/databases/$(database)/documents/matches/$(matchId)).data.team)
            && validOwnAvailability(availabilityUid));
        allow delete: if canManageMatch(
            get(/databases/$(database)/documents/matches/$(matchId)).data
          ) || (signedIn() && !isSupporter() && availabilityUid == request.auth.uid);
      }

      match /motm/{voterUid} {
        function matchData() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }
        function canReadBallots() {
          return !isSupporter() && (
            isAdmin()
            || hasPermission('score_invullen')
            || isDelegate(matchData().team)
            || (signedIn()
              && matchData().aangeduidePersonen is list
              && matchData().aangeduidePersonen.hasAny([request.auth.uid]))
          );
        }

        allow get: if canReadBallots()
          || (signedIn() && voterUid == request.auth.uid);
        allow list: if canReadBallots();
        allow create: if signedIn()
          && voterUid == request.auth.uid
          && canVoteForMatch(matchData())
          && request.resource.data.keys().hasAll(['votes', 'timestamp'])
          && request.resource.data.keys().hasOnly(['votes', 'timestamp'])
          && validVoteBallot(request.resource.data.votes, matchData(), request.auth.uid)
          && request.resource.data.timestamp is string
          && request.resource.data.timestamp.size() <= 40;
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if true;
        allow write: if canManageMatch(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        );
      }

      match /playerMinutes/{playerUid} {
        allow read: if canSeeMatchAttendance(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        );
        allow write: if canManageMatch(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        );
      }
    }

    match /evenementen/{eventId} {
      allow read: if true;
      allow write: if isAdmin();

      match /inschrijvingen/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid && !isSupporter());
        allow list: if isAdmin();
        allow create: if validEventRegistrationCreate(eventId, uid);
        allow update: if signedIn()
          && !isSupporter()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extraAntwoorden'])
          && request.resource.data.extraAntwoorden is list
          && request.resource.data.extraAntwoorden.size() <= 30;
        allow delete: if isAdmin() || (signedIn() && !isSupporter() && request.auth.uid == uid);
      }
    }

    match /werklijsten/{listId} {
      allow read: if isAdmin()
        || (hasUserProfile() && !isSupporter()
          && (!hasPermission('extern') || hasPermission('werken')));
      allow write: if isAdmin();

      match /shifts/{shiftId} {
        allow read: if isAdmin()
          || (hasUserProfile() && !isSupporter()
            && (!hasPermission('extern') || hasPermission('werken')));
        allow write: if isAdmin();
      }
    }

    match /trainingen/{trainingId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();

      match /availability/{uid} {
        allow read: if isAdmin() || (signedIn() && !isSupporter());
        allow write: if isAdmin();
      }
    }

    match /rockwerchter_bestellingen/{orderId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /rw_payments/{paymentId} {
      allow get: if isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/rw_payment_private/$(paymentId))
        && get(/databases/$(database)/documents/rw_payment_private/$(paymentId)).data.uid == request.auth.uid);
      allow list, write: if false;
    }

    match /rw_payment_private/{paymentId} {
      allow read, write: if false;
    }

    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shop_orders/{orderId} {
      allow get: if isAdmin()
        || (signedIn() && !isSupporter() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && !isSupporter()
        && request.resource.data.keys().hasAll([
          'userId', 'userName', 'userEmail', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'nieuw'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /rw_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galerij/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ranking/{rankingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notificaties/{notificationId} {
      allow read: if isAdmin() || resource.data.actief == true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isAdmin()
        || settingId in ['terms', 'privacy', 'announcement', 'siteSettings', 'webshop', 'kiosk'];
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
